<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="50dip"
                android:layout_centerVertical="true"
                android:background="@drawable/probation_background"
                android:paddingBottom="6dip"
                android:paddingLeft="4dip"
                android:paddingRight="4dip"
                android:paddingTop="6dip">

    <ImageView
        android:id="@+id/probation_icon"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginEnd="2dip"
        android:layout_marginTop="1dip"
        android:src="@drawable/warning"/>

    <TextView
        android:id="@+id/probation_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@+id/probation_icon"
        android:gravity="start"
        android:text="@string/probation_title"
        android:textColor="#ff000000"
        android:textIsSelectable="false"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="visible"/>

    <TextView
        android:id="@+id/probation_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/probation_title"
        android:gravity="start"
        android:singleLine="true"
        android:text="@string/probation_message"
        android:textColor="#ff000000"
        android:textIsSelectable="false"
        android:textSize="11sp"
        android:visibility="visible"/>

    <ImageButton
        android:id="@+id/close_probation_bar"
        style="@style/ActionBarButton"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_toStartOf="@id/go_to_LC"
        android:layout_marginEnd="10dp"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/ic_check_circle" />

    <ImageButton
        android:id="@+id/go_to_LC"
        style="@style/ActionBarButton"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/ic_arrow_forward"/>

</RelativeLayout>