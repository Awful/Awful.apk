<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical"
    android:padding="10dip"
    android:background="?attr/background"
    android:paddingBottom="0dip">

    <ImageView
        android:id="@+id/dealwithit"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:adjustViewBounds="true"
        android:contentDescription="@string/smugdog_description"
        android:scaleType="fitCenter"
        android:src="@drawable/dealwithit" />

    <TextView
        android:id="@+id/prompt_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:drawableStart="@drawable/emot_goonsay"
        android:drawablePadding="4dp"
        android:text="@string/login_message"
        android:textSize="18sp" />

    <LinearLayout
        android:id="@+id/login_text_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/prompt_msg"
        android:background="#AAFFFFFF"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/username"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:hint="@string/username"
                android:autofillHints="username"
                android:inputType="textVisiblePassword|textNoSuggestions">

                <requestFocus />
            </EditText>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/password"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:hint="@string/password"
                android:autofillHints="password"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <CheckBox
        android:id="@+id/login_accept"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/login_text_container"
        android:layout_alignParentStart="true"
        android:layout_marginEnd="5dip"
        android:layout_marginTop="5dip" />


    <TextView
        android:id="@+id/login_terms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/login_text_container"
        android:layout_toStartOf="@id/login"
        android:layout_toEndOf="@id/login_accept"
        android:layout_marginEnd="15dip"
        android:text="@string/terms_and_conditions" />

    <Button
        android:id="@+id/login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_below="@+id/login_text_container"
        android:background="#AAFFFFFF"
        android:drawablePadding="15dip"
        android:padding="15dip"
        android:enabled="false"
        android:text="@string/login" />

</RelativeLayout>
