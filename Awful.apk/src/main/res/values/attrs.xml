<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="StatusFrog">
        <attr name="status_message" format="string"/>
        <attr name="show_spinner" format="boolean"/>
    </declare-styleable>
    <bool name="legacy_shortcut_creation">true</bool>
    <attr name="pagebarPadding" format="dimension"/>
    <attr name="navbarPadding" format="dimension"/>
    <declare-styleable name="SwipyRefreshLayout">
        <attr name="srl_direction">
            <enum name="top" value="0" />
            <enum name="bottom" value="1" />
            <enum name="both" value="2" />
        </attr>
    </declare-styleable>
</resources>